DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required. Random string of at least 32 characters; the server refuses to
# create or read sessions without it. Generate with: openssl rand -base64 48
CLOUDMART_SESSION_SECRET=""

# Required for admin console access. Admin sign-in needs this key plus the
# password of the admin account (set when the first admin is bootstrapped).
CLOUDMART_ADMIN_ACCESS_KEY=""

GLOBALGLE_API_BASE_URL="https://tudowebs.com/api/v1"
GLOBALGLE_API_KEY=""
GLOBALGLE_WEBHOOK_SECRET=""

CLOUDMART_DEFAULT_MARKUP_PERCENT="15"
CLOUDMART_USD_TO_NGN="1600"

PAYSTACK_SECRET_KEY=""
CLOUDMART_PAYMENT_CALLBACK_URL=""
